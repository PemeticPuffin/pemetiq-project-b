# Required
ANTHROPIC_API_KEY=your_key_here

# Optional — override defaults
ANTHROPIC_MODEL=claude-sonnet-4-6
DAILY_SPEND_LIMIT_USD=5.00
SPEND_LEDGER_PATH=data/spend_ledger.json

# Adzuna (register free at developer.adzuna.com)
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# GitHub (free account token — increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=your_github_token

# Durable run-log (Supabase) — shared with Cadillaq. Unset = logging is a no-op.
# SUPABASE_KEY must be the service_role key (server-side only, never in the browser).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key
